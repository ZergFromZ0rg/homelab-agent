# Copy to .env beside compose.yml. Only HOST_NAME is required.

# Must equal this host's Prometheus job_name.
HOST_NAME=bigboy

# Bind address for port 8123. On a plain LAN use the tailnet address
# (100.x.y.z) so the agent isn't reachable from the whole subnet.
AGENT_BIND=0.0.0.0

# Shared with the dashboard's AGENT_TOKEN. Required for the container
# control/deploy routes and for GET /connections.
AGENT_TOKEN=

# Registration. REGISTER_TOKEN must equal the dashboard's API_TOKEN.
DASHBOARD_URL=
AGENT_URL=
REGISTER_TOKEN=

# Configuration backup. GITHUB_TOKEN is a fine-grained PAT with
# Contents: read and write on BACKUP_REPO only.
BACKUP_REPO=
GITHUB_TOKEN=
BACKUP_INTERVAL_HOURS=12
STACK_DIRS=

# Deploy policy. Empty ALLOWED_HOST_PATHS = named volumes only.
ALLOWED_REGISTRIES=
ALLOWED_HOST_PATHS=
ALLOWED_DEVICES=

# Volume backups. Directories *inside this container* that archives may be
# written to; each must be a writable bind mount, which is what stops a
# backup request naming any path on the host. Empty = this host stores no
# backups (it can still be a source). Pair with a volume line:
#   - /srv/backups:/backups
BACKUP_DIRS=

# The address other *hosts* can reach this agent at, for backups sent here
# from another node. Only needed when AGENT_URL is a name that only the
# dashboard's network resolves, e.g. a container name.
BACKUP_PUBLIC_URL=

# Lets the dashboard pull and rebuild this host's Compose projects.
# Leave empty unless you want that: it runs whatever the repo and its
# Dockerfile say, as root on this host.
REBUILD_ENABLED=

# Set to "nvidia" on hosts with an NVIDIA card and the container toolkit
# installed. Anything else leaves the default runtime alone.
AGENT_RUNTIME=

LOG_LEVEL=INFO
